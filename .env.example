# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais commiter .env.local.

# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://iloyliuzsflzbkhpvxjt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé API Claude (console.anthropic.com) : utilisée uniquement côté serveur
ANTHROPIC_API_KEY=
ANTHROPIC_MODELE=claude-haiku-5-5

# Adresse publique du site (pour les liens de partage et les aperçus)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Business (messages automatiques des commandes, US-20.5) : utilisés uniquement côté serveur.
# Vides = aucun envoi : les messages restent dans la table messages_whatsapp (statut a_envoyer).
WHATSAPP_FOURNISSEUR=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LANGUE=fr
WHATSAPP_API_VERSION=v23.0
# Secret de la tâche planifiée GET /api/notifications/whatsapp (32 caractères aléatoires au moins).
# Ranger aussi son empreinte SHA-256 dans la base (prive.reglages, voir docs/architecture.md).
CRON_SECRET=

# Connexion des clients (US-21) : « email » (par défaut, lien e-mail) ou « telephone » (numéro + code WhatsApp).
# Passer à « telephone » seulement quand Twilio Verify est configuré dans Supabase (voir docs/ETAT.md).
# Les clés Twilio et la clé secrète Turnstile se saisissent UNIQUEMENT dans le tableau de bord Supabase, jamais ici.
CONNEXION_CLIENT=email
# Secret serveur des limites d'envoi des codes (1 par minute, 5 par heure et par numéro), distinct de CRON_SECRET.
# 32 caractères aléatoires au moins ; ranger son empreinte SHA-256 dans la base (prive.reglages, clé
# « jeton_codes_telephone », voir docs/architecture.md). Vide = aucun code envoyé.
CODES_TELEPHONE_SECRET=
# Clé de site Cloudflare Turnstile (publique). Vide = pas de contrôle anti-robot affiché.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
